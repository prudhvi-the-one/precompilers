generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  STUDENT
  ADMIN
  MENTOR
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum Entitlement {
  FREE
  INDIVIDUAL
  INSTITUTION
}

enum TargetRole {
  SOFTWARE_ENGINEER
  DATA_ML_ENGINEER
  FRONTEND_ENGINEER
  CLOUD_DEVOPS
  HIGHER_STUDIES
  NOT_SURE
}

enum QuizKind {
  TOPIC_QUIZ
  APTITUDE_PAPER
}

enum QuestionType {
  SINGLE_CHOICE
}

enum HireVerdict {
  NOT_YET
  CLOSE
  YES
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  role            Role        @default(STUDENT)
  name            String?
  college         String?
  branch          String?
  gradYear        Int?
  weeklyHours     String?
  targetRole      TargetRole?
  entitlement     Entitlement @default(FREE)
  emailVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  otps            Otp[]
  enrollment      Enrollment?
  lectureProgress LectureProgress[]
  quizAttempts    QuizAttempt[]
  submissions       ProjectSubmission[]
  reviewsGiven      PeerReview[]         @relation("ReviewsGiven")
  mockRequests      MockRequest[]
  mockFeedbackGiven MockFeedback[]       @relation("MockFeedbackGiven")
  mockFeedbackRecv  MockFeedback[]       @relation("MockFeedbackReceived")
  gdParticipations  GdParticipant[]
  gdRatingsGiven    GdRating[]           @relation("GdRatingsGiven")
  gdRatingsReceived GdRating[]           @relation("GdRatingsReceived")
}

model Otp {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

model Track {
  id                  String       @id @default(cuid())
  slug                String       @unique
  name                String
  tagline             String
  order               Int          @default(0)
  requiredEntitlement Entitlement  @default(FREE)
  relevantRoles       TargetRole[]

  batches     Batch[]
  lectures    Lecture[]
  notes       Note[]
  enrollments Enrollment[]
}

model Note {
  id      String @id @default(cuid())
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  order   Int    @default(0)
  title   String
  content String

  @@index([trackId])
}

model Batch {
  id       String   @id @default(cuid())
  trackId  String
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name     String
  startsAt DateTime

  enrollments Enrollment[]
  liveClasses LiveClass[]

  @@index([trackId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  batchId   String?
  batch     Batch?   @relation(fields: [batchId], references: [id])
  createdAt DateTime @default(now())
}

model Lecture {
  id              String @id @default(cuid())
  trackId         String
  track           Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  order           Int    @default(0)
  title           String
  description     String
  videoUrl        String
  durationMinutes Int

  progress LectureProgress[]

  @@index([trackId])
}

model LectureProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureId   String
  lecture     Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  completedAt DateTime?

  @@unique([userId, lectureId])
}

model LiveClass {
  id              String   @id @default(cuid())
  batchId         String
  batch           Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title           String
  scheduledAt     DateTime
  durationMinutes Int
  joinUrl         String

  @@index([batchId])
}

model Quiz {
  id                  String      @id @default(cuid())
  slug                String      @unique
  title               String
  topic               String
  kind                QuizKind
  requiredEntitlement Entitlement @default(FREE)
  order               Int         @default(0)

  sections QuizSection[]
  attempts QuizAttempt[]
}

model QuizSection {
  id              String @id @default(cuid())
  quizId          String
  quiz            Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order           Int    @default(0)
  name            String
  durationMinutes Int

  questions Question[]
  attempts  SectionAttempt[]

  @@index([quizId])
}

model Question {
  id        String       @id @default(cuid())
  sectionId String
  section   QuizSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order     Int          @default(0)
  text      String
  marks     Int          @default(1)
  type      QuestionType @default(SINGLE_CHOICE)

  options   QuestionOption[]
  responses QuestionResponse[]

  @@index([sectionId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  label      String
  text       String
  isCorrect  Boolean  @default(false)

  responses QuestionResponse[]

  @@index([questionId])
}

model QuizAttempt {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId          String
  quiz            Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  proctored       Boolean   @default(false)
  startedAt       DateTime  @default(now())
  submittedAt     DateTime?
  score           Int?
  endedByViolation Boolean  @default(false)
  violationCount  Int       @default(0)

  sectionAttempts   SectionAttempt[]
  questionResponses QuestionResponse[]

  @@index([userId, quizId])
}

model SectionAttempt {
  id          String      @id @default(cuid())
  attemptId   String
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionId   String
  section     QuizSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  startedAt   DateTime    @default(now())
  submittedAt DateTime?
  score       Int?

  @@unique([attemptId, sectionId])
}

model QuestionResponse {
  id               String          @id @default(cuid())
  attemptId        String
  attempt          QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])
  flagged          Boolean         @default(false)
  seen             Boolean         @default(false)

  @@unique([attemptId, questionId])
}

model Project {
  id                  String      @id @default(cuid())
  slug                String      @unique
  title               String
  brief               String
  order               Int         @default(0)
  requiredEntitlement Entitlement @default(FREE)

  submissions ProjectSubmission[]
}

model ProjectSubmission {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionUrl String
  description   String
  submittedAt   DateTime  @default(now())

  reviews PeerReview[]

  @@unique([projectId, userId])
}

model PeerReview {
  id           String      @id @default(cuid())
  submissionId String
  submission   ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User        @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  correctness  Int
  efficiency   Int
  readability  Int
  wouldHire    HireVerdict
  comment      String
  submittedAt  DateTime    @default(now())

  @@unique([submissionId, reviewerId])
}

model MockRequest {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  pairedWithId String?      @unique
  pairedWith   MockRequest? @relation("MockPair", fields: [pairedWithId], references: [id])
  pairOf       MockRequest? @relation("MockPair")
  roomUrl      String?
  scheduledAt  DateTime?

  feedbackGiven   MockFeedback[] @relation("FeedbackByRequest")
}

model MockFeedback {
  id            String      @id @default(cuid())
  mockRequestId String
  mockRequest   MockRequest @relation("FeedbackByRequest", fields: [mockRequestId], references: [id], onDelete: Cascade)
  raterId       String
  rater         User        @relation("MockFeedbackGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId       String
  ratee         User        @relation("MockFeedbackReceived", fields: [rateeId], references: [id], onDelete: Cascade)
  score         Int
  quote         String
  createdAt     DateTime    @default(now())

  @@unique([mockRequestId, raterId])
}

model GdSession {
  id              String   @id @default(cuid())
  topic           String
  scheduledAt     DateTime
  roomUrl         String
  minParticipants Int      @default(5)

  participants GdParticipant[]
  ratings      GdRating[]
}

model GdParticipant {
  id             String    @id @default(cuid())
  sessionId      String
  session        GdSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime  @default(now())
  speakingSeconds Int      @default(0)

  @@unique([sessionId, userId])
}

model GdRating {
  id        String    @id @default(cuid())
  sessionId String
  session   GdSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User      @relation("GdRatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId   String
  ratee     User      @relation("GdRatingsReceived", fields: [rateeId], references: [id], onDelete: Cascade)
  clarity   Int
  content   Int
  courtesy  Int

  @@unique([sessionId, raterId, rateeId])
}
