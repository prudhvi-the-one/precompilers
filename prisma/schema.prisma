generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  STUDENT
  MENTOR
  FACULTY
  INSTITUTION_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum Entitlement {
  FREE
  INDIVIDUAL
  INSTITUTION
}

enum TargetRole {
  SOFTWARE_ENGINEER
  DATA_ML_ENGINEER
  FRONTEND_ENGINEER
  CLOUD_DEVOPS
  HIGHER_STUDIES
  NOT_SURE
}

enum QuizKind {
  TOPIC_QUIZ
  APTITUDE_PAPER
}

enum QuestionType {
  SINGLE_CHOICE
}

enum HireVerdict {
  NOT_YET
  CLOSE
  YES
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionVerdict {
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  COMPILE_ERROR
}

enum MentorSessionKind {
  MOCK
  HR_ROUND
  COUNSELLING
}

enum MentorSessionStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  role            Role        @default(STUDENT)
  name            String?
  college         String?
  branch          String?
  gradYear        Int?
  weeklyHours     String?
  targetRole      TargetRole?
  entitlement     Entitlement @default(FREE)
  emailVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  institutionId  String?
  institution    Institution? @relation(fields: [institutionId], references: [id])
  facultyBatchId String?
  facultyBatch   Batch?       @relation("BatchFaculty", fields: [facultyBatchId], references: [id])

  otps            Otp[]
  enrollment      Enrollment?
  lectureProgress LectureProgress[]
  quizAttempts    QuizAttempt[]
  submissions       ProjectSubmission[]
  problemSubmissions Submission[]
  problemComments    Comment[]
  mentorProfile           MentorProfile?
  mentorSessionsAsStudent MentorSession[]
  authoredQuizzes   Quiz[]               @relation("QuizAuthor")
  reviewedQuizzes   Quiz[]               @relation("QuizReviewer")
  authoredProblems  Problem[]            @relation("ProblemAuthor")
  reviewedProblems  Problem[]            @relation("ProblemReviewer")
  reviewsGiven      PeerReview[]         @relation("ReviewsGiven")
  mockRequests      MockRequest[]
  mockFeedbackGiven MockFeedback[]       @relation("MockFeedbackGiven")
  mockFeedbackRecv  MockFeedback[]       @relation("MockFeedbackReceived")
  gdParticipations  GdParticipant[]
  gdRatingsGiven    GdRating[]           @relation("GdRatingsGiven")
  gdRatingsReceived GdRating[]           @relation("GdRatingsReceived")

  @@index([institutionId, role])
}

model Otp {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

model Track {
  id                  String       @id @default(cuid())
  slug                String       @unique
  name                String
  tagline             String
  order               Int          @default(0)
  requiredEntitlement Entitlement  @default(FREE)
  relevantRoles       TargetRole[]

  batches     Batch[]
  lectures    Lecture[]
  notes       Note[]
  enrollments Enrollment[]
}

model Note {
  id      String @id @default(cuid())
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  order   Int    @default(0)
  title   String
  content String

  @@index([trackId])
}

model Batch {
  id       String   @id @default(cuid())
  trackId  String
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name     String
  startsAt DateTime

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  enrollments Enrollment[]
  liveClasses LiveClass[]
  faculty     User[]       @relation("BatchFaculty")

  @@index([trackId])
  @@index([institutionId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  batchId   String?
  batch     Batch?   @relation(fields: [batchId], references: [id])
  createdAt DateTime @default(now())
}

model Lecture {
  id              String @id @default(cuid())
  trackId         String
  track           Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  order           Int    @default(0)
  title           String
  description     String
  videoUrl        String
  durationMinutes Int

  progress LectureProgress[]

  @@index([trackId])
}

model LectureProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureId   String
  lecture     Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  completedAt DateTime?

  @@unique([userId, lectureId])
}

model LiveClass {
  id              String   @id @default(cuid())
  batchId         String
  batch           Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title           String
  scheduledAt     DateTime
  durationMinutes Int
  joinUrl         String

  @@index([batchId])
}

model Quiz {
  id                  String      @id @default(cuid())
  slug                String      @unique
  title               String
  topic               String
  kind                QuizKind
  requiredEntitlement Entitlement @default(FREE)
  order               Int         @default(0)

  status          ContentStatus @default(PUBLISHED)
  authorId        String?
  author          User?         @relation("QuizAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?         @relation("QuizReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sections QuizSection[]
  attempts QuizAttempt[]

  @@index([status])
  @@index([authorId])
}

model QuizSection {
  id              String @id @default(cuid())
  quizId          String
  quiz            Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order           Int    @default(0)
  name            String
  durationMinutes Int

  questions Question[]
  attempts  SectionAttempt[]

  @@index([quizId])
}

model Question {
  id        String       @id @default(cuid())
  sectionId String
  section   QuizSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order     Int          @default(0)
  text      String
  marks     Int          @default(1)
  type      QuestionType @default(SINGLE_CHOICE)

  options   QuestionOption[]
  responses QuestionResponse[]

  @@index([sectionId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  label      String
  text       String
  isCorrect  Boolean  @default(false)

  responses QuestionResponse[]

  @@index([questionId])
}

model QuizAttempt {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId          String
  quiz            Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  proctored       Boolean   @default(false)
  startedAt       DateTime  @default(now())
  submittedAt     DateTime?
  score           Int?
  endedByViolation Boolean  @default(false)
  violationCount  Int       @default(0)
  recordingKey    String?

  sectionAttempts   SectionAttempt[]
  questionResponses QuestionResponse[]

  @@index([userId, quizId])
}

model SectionAttempt {
  id          String      @id @default(cuid())
  attemptId   String
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionId   String
  section     QuizSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  startedAt   DateTime    @default(now())
  submittedAt DateTime?
  score       Int?

  @@unique([attemptId, sectionId])
}

model QuestionResponse {
  id               String          @id @default(cuid())
  attemptId        String
  attempt          QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])
  flagged          Boolean         @default(false)
  seen             Boolean         @default(false)

  @@unique([attemptId, questionId])
}

model Project {
  id                  String      @id @default(cuid())
  slug                String      @unique
  title               String
  brief               String
  order               Int         @default(0)
  requiredEntitlement Entitlement @default(FREE)

  submissions ProjectSubmission[]
}

model ProjectSubmission {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionUrl String
  description   String
  submittedAt   DateTime  @default(now())

  reviews PeerReview[]

  @@unique([projectId, userId])
}

model PeerReview {
  id           String      @id @default(cuid())
  submissionId String
  submission   ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User        @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  correctness  Int
  efficiency   Int
  readability  Int
  wouldHire    HireVerdict
  comment      String
  submittedAt  DateTime    @default(now())

  @@unique([submissionId, reviewerId])
}

model MockRequest {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  pairedWithId String?      @unique
  pairedWith   MockRequest? @relation("MockPair", fields: [pairedWithId], references: [id])
  pairOf       MockRequest? @relation("MockPair")
  roomUrl      String?
  scheduledAt  DateTime?

  feedbackGiven   MockFeedback[] @relation("FeedbackByRequest")
}

model MockFeedback {
  id            String      @id @default(cuid())
  mockRequestId String
  mockRequest   MockRequest @relation("FeedbackByRequest", fields: [mockRequestId], references: [id], onDelete: Cascade)
  raterId       String
  rater         User        @relation("MockFeedbackGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId       String
  ratee         User        @relation("MockFeedbackReceived", fields: [rateeId], references: [id], onDelete: Cascade)
  score         Int
  quote         String
  createdAt     DateTime    @default(now())

  @@unique([mockRequestId, raterId])
}

model GdSession {
  id              String   @id @default(cuid())
  topic           String
  scheduledAt     DateTime
  roomUrl         String
  minParticipants Int      @default(5)

  participants GdParticipant[]
  ratings      GdRating[]
}

model GdParticipant {
  id             String    @id @default(cuid())
  sessionId      String
  session        GdSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime  @default(now())
  speakingSeconds Int      @default(0)

  @@unique([sessionId, userId])
}

model GdRating {
  id        String    @id @default(cuid())
  sessionId String
  session   GdSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User      @relation("GdRatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId   String
  ratee     User      @relation("GdRatingsReceived", fields: [rateeId], references: [id], onDelete: Cascade)
  clarity   Int
  content   Int
  courtesy  Int

  @@unique([sessionId, raterId, rateeId])
}

model Problem {
  id                  String      @id @default(cuid())
  slug                String      @unique
  title               String
  difficulty          Difficulty
  category            String
  tags                String[]
  companies           String[]
  statement           String
  examples            Json
  constraints         String
  hints               String
  solutionExplanation String
  requiredEntitlement Entitlement @default(FREE)
  order               Int         @default(0)

  status          ContentStatus @default(PUBLISHED)
  authorId        String?
  author          User?         @relation("ProblemAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?         @relation("ProblemReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  testCases   TestCase[]
  submissions Submission[]
  comments    Comment[]

  @@index([status])
  @@index([authorId])
}

model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order          Int     @default(0)
  input          String
  expectedOutput String
  isSample       Boolean @default(false)

  @@index([problemId])
}

model Submission {
  id          String            @id @default(cuid())
  problemId   String
  problem     Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  language    String
  sourceCode  String
  verdict     SubmissionVerdict
  passedCount Int
  totalCount  Int
  runtimeMs   Int?
  memoryKb    Int?
  submittedAt DateTime          @default(now())

  @@index([userId, problemId])
}

model Comment {
  id        String   @id @default(cuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([problemId])
}

model MentorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations String[]
  bio             String
  capacityPerDay  Int      @default(10)

  availability MentorAvailability[]
  sessions     MentorSession[]
}

model MentorAvailability {
  id              String        @id @default(cuid())
  mentorId        String
  mentor          MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  durationMinutes Int           @default(30)
  isBooked        Boolean       @default(false)

  session MentorSession?

  @@index([mentorId, startsAt])
}

model MentorSession {
  id        String              @id @default(cuid())
  kind      MentorSessionKind
  mentorId  String
  mentor    MentorProfile       @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  studentId String
  student   User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slotId    String              @unique
  slot      MentorAvailability  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  roomUrl   String?
  status    MentorSessionStatus @default(BOOKED)
  notes     String?

  scorecard MentorScorecard?

  @@index([studentId])
}

model MentorScorecard {
  id              String        @id @default(cuid())
  sessionId       String        @unique
  session         MentorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  technical       Int
  communication   Int
  problemSolving  Int
  confidence      Int
  verdict         HireVerdict
  writtenFeedback String
  submittedAt     DateTime      @default(now())
}

model Institution {
  id        String    @id @default(cuid())
  name      String
  seatCount Int
  renewsAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users   User[]
  batches Batch[]
}
