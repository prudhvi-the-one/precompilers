# Postgres (Neon). DATABASE_URL is the pooled connection string (used at
# runtime); DATABASE_URL_UNPOOLED is the direct, non-pooled connection string
# (used by Prisma Migrate). These exact names are what Vercel's Storage tab
# auto-provisions when you add Postgres via its Neon integration — matching
# them here means nothing needs renaming between local and Vercel.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Random secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# Resend (email delivery). Get an API key from https://resend.com/api-keys.
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Must be an address on a domain you've verified in Resend. Until you verify
# precompilers.com there, Resend's shared sandbox address only delivers to
# your own Resend account email.
RESEND_FROM_EMAIL="PreCompilers <onboarding@resend.dev>"

# WhatsApp (Meta Cloud API — developers.facebook.com). Create a Business-type
# app, add the WhatsApp product, and these two values come from that app's
# API Setup page. A test app's free test number can message up to 5
# OTP-verified recipient numbers at zero cost, no business verification
# needed — enough for prototype-stage testing.
WHATSAPP_ACCESS_TOKEN="replace-with-a-meta-access-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-a-phone-number-id"
# Optional. Meta's Cloud API can only send proactive (business-initiated)
# messages via a pre-approved template. Until you create and get one approved
# in WhatsApp Manager, leave this unset — sends fall back to Meta's built-in,
# zero-approval "hello_world" template (fixed English content, no
# parameters), which is enough to prove the pipeline works end to end.
WHATSAPP_TEMPLATE_NAME=""

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` on
# scheduled invocations (see vercel.json). Generate one with:
#   openssl rand -base64 32
CRON_SECRET="replace-with-a-generated-secret"

# Sentry (error monitoring — sentry.io, free tier is enough at this scale).
# Create a project (platform: Next.js), then these come from Settings ->
# Client Keys (DSN) and the org/project slugs in the URL. Left unset, the SDK
# no-ops safely — errors just won't be reported anywhere.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Optional, only needed for uploading source maps for readable stack traces.
# Settings -> Auth Tokens in Sentry.
SENTRY_AUTH_TOKEN=""
